{
  "name": "surucubby",
  "version": "1.0.0",
  "description": "骏河屋拼团「个人仓库」：Excel 导入、客户专属页、称重分摊、收款与寄出管理",
  "scripts": {
    "dev": "node --watch --disable-warning=ExperimentalWarning src/server.ts",
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\" test/sheet.test.mjs test/xlsx.test.mjs test/public.test.mjs",
    "test:e2e": "node scripts/sandbox.mjs --state .sandbox/e2e --port 8791 -- node --test --test-concurrency=1 test/e2e.test.mjs test/warehouse.e2e.test.mjs test/v3.e2e.test.mjs",
    "seed": "node scripts/sandbox.mjs --state .sandbox/demo --port 8790 --keep -- node scripts/seed-demo.mjs",
    "preview": "node scripts/build-preview.mjs",
    "vendor": "node scripts/fetch-vendor.mjs",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:db:local": "wrangler d1 migrations apply surucubby --local",
    "worker:db:remote": "wrangler d1 migrations apply surucubby --remote"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/COLDDCC/SuruCubby.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/COLDDCC/SuruCubby/issues"
  },
  "homepage": "https://github.com/COLDDCC/SuruCubby#readme",
  "dependencies": {
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.135.0",
    "@types/node": "^24.0.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  }
}
